{
	"name": "tiktok-clone-api",
	"version": "1.0.0",
	"main": "index.js",
	"license": "MIT",
	"scripts": {
		"dev": "node --watch -r ts-node/register src/app.ts",
		"typeorm": "typeorm-ts-node-commonjs",
		"build": "node scripts/clean.cjs && tsc -p .",
		"migrate": "npm run build && npm run typeorm -- migration:generate ./src/migrations/structure -d ./src/utils/data-source.ts",
		"db:push": "npm run build && npm run typeorm -- migration:run -d src/utils/data-source.ts",
		"start": "node build/src/app.js",
		"lint": "eslint src",
		"test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs"
	},
	"devDependencies": {
		"@types/cookie-parser": "1.4.10",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/morgan": "1.9.10",
		"@types/multer": "2.3.0",
		"@types/node": "26.6.5",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"eslint": "10.13.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"@types/jsonwebtoken": "9.0.10"
	},
	"dependencies": {
		"argon2": "0.45.1",
		"config": "5.0.1",
		"cookie-parser": "1.4.7",
		"cors": "2.8.6",
		"dotenv": "18.0.9",
		"envalid": "9.0.0",
		"express": "5.3.0",
		"jsonwebtoken": "9.0.3",
		"multer": "2.5.0",
		"pg": "8.23.1",
		"redis": "6.3.0",
		"reflect-metadata": "0.2.2",
		"sharp": "0.35.5",
		"socket.io": "4.8.4",
		"typeorm": "1.1.2",
		"zod": "4.6.7",
		"morgan": "1.12.1"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"allowScripts": {
		"argon2@0.45.1": true
	}
}
